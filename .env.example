# Required by the generic AWS deployment. CloudFront certificates must be in us-east-1.
TEAMSPACES_DOMAIN_NAME=team-spaces.example.com
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/replace-me

# Optional AWS credential selection. Leave unset to use the normal AWS SDK chain.
# AWS_PROFILE=your-profile
# AWS_REGION=us-east-1

# Optional installation identity. Defaults shown here are the community defaults.
TEAMSPACES_STACK_NAME=teamspaces-community
TEAMSPACES_WORKSPACE_NAME="Team Spaces"
TEAMSPACES_APPLICATION_TAG=teamspaces
TEAMSPACES_ENVIRONMENT_TAG=community
TEAMSPACES_OWNER_TAG=self-hosted
TEAMSPACES_COST_CENTER_TAG=teamspaces
# TEAMSPACES_COGNITO_DOMAIN_PREFIX=globally-unique-prefix

# Optional hosted-profile branding override. It must be an absolute directory
# containing the three filenames documented in infra/lib/auth-branding.js.
# TEAMSPACES_MANAGED_LOGIN_BRANDING_ASSET_DIRECTORY=/absolute/path/to/auth-branding

# Keep the scalable cross-project reader off until the documented verifier writes
# its readiness marker. A new or empty installation may run the same verification.
TEAMSPACES_WORK_INDEX_READY=false

# Optional layers. The minimal community profile leaves all three false.
TEAMSPACES_ENABLE_PITR=false
TEAMSPACES_ENABLE_OPERATIONS=false
TEAMSPACES_ENABLE_PUBLIC_DEMO=false
# Optional separate browser origin for the enabled shared demo. The viewer
# certificate must cover both TEAMSPACES_DOMAIN_NAME and this exact hostname.
# TEAMSPACES_PUBLIC_DEMO_DOMAIN_NAME=demo.team-spaces.example.com

# Security-sensitive development exception. Keep false outside deliberate
# localhost testing against a deployed backend.
TEAMSPACES_ALLOW_LOCAL_DEVELOPMENT_ORIGINS=false
# TEAMSPACES_BUDGET_EMAIL=owner@example.com

# Data portability commands use these separately from deployment.
# TABLE_NAME=exact-dynamodb-table-name
# EXPORT_PATH=team-spaces-data.json
# IMPORT_PATH=team-spaces-data.json
